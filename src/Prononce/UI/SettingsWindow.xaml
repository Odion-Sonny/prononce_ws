<Window x:Class="Prononce.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prononce Settings"
        Width="520"
        Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#18181B"
        Foreground="#FFFFFF">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#60A5FA" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#18181B" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                BorderBrush="#3F3F46"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3F3F46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Title & App Info -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="🇫🇷" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Prononce for Windows" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Instant French pronunciation utility for learners" FontSize="12" Foreground="#A1A1AA" />
                    </StackPanel>
                </StackPanel>

                <Border BorderThickness="0,0,0,1" BorderBrush="#27272A" Margin="0,0,0,10" />

                <!-- Speech Voice Section -->
                <TextBlock Text="Speech Voice" Style="{StaticResource SectionHeader}" Margin="0,4,0,8" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="VoiceComboBox" SelectionChanged="OnVoiceSelectionChanged" Grid.Column="0" Margin="0,0,10,0" />
                    <Button Style="{StaticResource OutlineButton}" Grid.Column="1" Click="OnTestVoiceClicked" Content="▶ Test Voice" />
                </Grid>

                <Button Style="{StaticResource OutlineButton}"
                        HorizontalAlignment="Left"
                        Click="OnAddVoicesInWindowsClicked"
                        Content="Install More French Voices in Windows Settings..."
                        Margin="0,0,0,12" />

                <!-- Playback Speed Section -->
                <TextBlock Text="Default Playback Speed" Style="{StaticResource SectionHeader}" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SpeedSlider"
                            Minimum="0.5"
                            Maximum="1.5"
                            TickFrequency="0.25"
                            IsSnapToTickEnabled="True"
                            ValueChanged="OnSpeedSliderChanged"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
                    <TextBlock x:Name="SpeedLabel"
                               Text="1.0x"
                               FontWeight="Bold"
                               Grid.Column="1"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Translation Section -->
                <TextBlock Text="Offline English Translation" Style="{StaticResource SectionHeader}" />
                <ComboBox x:Name="TranslationComboBox" SelectionChanged="OnTranslationSelectionChanged" Margin="0,0,0,12" />

                <!-- Preferences Section -->
                <TextBlock Text="Preferences" Style="{StaticResource SectionHeader}" />
                <CheckBox x:Name="FloatingPanelCheckBox"
                          Content="Show floating pronunciation card on speak"
                          Checked="OnFloatingPanelChanged"
                          Unchecked="OnFloatingPanelChanged" />
                <CheckBox x:Name="LaunchAtStartupCheckBox"
                          Content="Launch automatically when Windows starts"
                          Checked="OnLaunchAtStartupChanged"
                          Unchecked="OnLaunchAtStartupChanged" />

                <!-- Shortcut Section -->
                <TextBlock Text="Global Hotkey" Style="{StaticResource SectionHeader}" />
                <Border Background="#27272A" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="Press to pronounce selected text:" VerticalAlignment="Center" />
                        <Border Background="#18181B"
                                BorderThickness="1"
                                BorderBrush="#3F3F46"
                                CornerRadius="4"
                                Padding="8,4"
                                HorizontalAlignment="Right">
                            <TextBlock Text="Ctrl + Shift + F"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"
                                       Foreground="#60A5FA" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Bottom Close Button -->
                <Button Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Right"
                        Width="100"
                        Click="OnCloseClicked"
                        Content="Done"
                        Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
