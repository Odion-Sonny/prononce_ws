<Window x:Class="Prononce.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Prononce"
        Width="480"
        Height="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#18181B"
        Foreground="#FFFFFF">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E4E7" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                BorderBrush="#3F3F46"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <StackPanel VerticalAlignment="Center">
            <!-- Header -->
            <TextBlock Text="🇫🇷" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <TextBlock Text="Welcome to Prononce"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4" />
            <TextBlock Text="Instant French pronunciation utility for learners"
                       FontSize="13"
                       Foreground="#A1A1AA"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24" />

            <!-- Step 1: Hotkey -->
            <Border Background="#27272A" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⌨️" FontSize="18" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Global Shortcut" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Select French text anywhere and press" FontSize="11" Foreground="#A1A1AA" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Background="#18181B"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="Ctrl + Shift + F"
                                   FontFamily="Consolas"
                                   FontWeight="Bold"
                                   Foreground="#60A5FA" />
                    </Border>
                </Grid>
            </Border>

            <!-- Step 2: Voice Check -->
            <Border Background="#27272A" CornerRadius="8" Padding="14,10" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🗣️" FontSize="18" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="French Speech Engine" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="VoiceStatusText" Text="Checking installed voices..." FontSize="11" Foreground="#A1A1AA" />
                    </StackPanel>
                    <Button x:Name="InstallVoiceBtn"
                            Grid.Column="2"
                            Style="{StaticResource OutlineButton}"
                            Content="Add French Voice"
                            Click="OnInstallVoiceClicked"
                            Visibility="Collapsed"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <Button Style="{StaticResource AccentButton}"
                    Content="Get Started"
                    Click="OnGetStartedClicked"
                    Margin="0,0,0,10" />

            <Button Style="{StaticResource OutlineButton}"
                    Content="▶ Test Pronunciation"
                    Click="OnTestClicked"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
