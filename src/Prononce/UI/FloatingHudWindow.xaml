<Window x:Class="Prononce.UI.FloatingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prononce HUD"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="HudButton" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="#22FFFFFF"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#553B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#88FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="#F21E1E24"
                CornerRadius="14"
                BorderThickness="1"
                BorderBrush="#33FFFFFF"
                Padding="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  Color="#000000"
                                  Opacity="0.45"
                                  ShadowDepth="6"
                                  Direction="270" />
            </Border.Effect>

            <StackPanel>
                <!-- Header row: Flag, title, and close button -->
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🇫🇷" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Prononce"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#A0A0B0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="VoiceLabel"
                                   Text=""
                                   FontSize="11"
                                   Foreground="#707085"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource CloseButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="OnCloseClicked"
                            Content="✕" />
                </Grid>

                <!-- Spoken text display -->
                <TextBlock x:Name="SpokenTextBlock"
                           Text="Bonjour !"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap"
                           MaxHeight="120"
                           Margin="0,0,0,8" />

                <!-- Offline Translation / Definition Container -->
                <Border x:Name="TranslationBorder"
                        Background="#1A3B82F6"
                        BorderBrush="#333B82F6"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,6"
                        Margin="0,0,0,10"
                        Visibility="Visible">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📖 " FontSize="11" Foreground="#60A5FA" VerticalAlignment="Center" />
                        <TextBlock x:Name="TranslationTextBlock"
                                   Text="hello, good morning"
                                   FontSize="12"
                                   Foreground="#93C5FD"
                                   TextWrapping="Wrap"
                                   MaxWidth="260"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Action Controls Row -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Style="{StaticResource HudButton}" Click="OnReplayClicked" Content="↻ Replay" />
                    <Button Style="{StaticResource HudButton}" Click="OnSlowClicked" Content="🐢 0.75x" />
                    <Button Style="{StaticResource HudButton}" Click="OnNormalClicked" Content="1.0x" />
                    <Button x:Name="TranslateToggleBtn"
                            Style="{StaticResource HudButton}"
                            Click="OnTranslateToggleClicked"
                            Content="Translate"
                            Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
